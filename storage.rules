rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') in ['ADMIN', 'ADMINISTRATOR', 'admin', 'administrator'] ||
        (request.auth.token.email != null &&
          request.auth.token.email_verified == true &&
          request.auth.token.email.lower() == 'saranramesh709@gmail.com')
      );
    }

    function isSafeFileSize() {
      return request.resource != null && request.resource.size < 15 * 1024 * 1024;
    }

    match /employees/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) || isAdmin()) && isSafeFileSize();
    }

    match /interns/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) || isAdmin()) && isSafeFileSize();
    }

    match /clients/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin() && isSafeFileSize();
    }

    match /projects/{projectId}/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isSafeFileSize();
    }

    match /invoices/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin() && isSafeFileSize();
    }

    match /certificates/{userId}/{document=**} {
      allow read: if true;
      allow write: if isAdmin() && isSafeFileSize();
    }

    match /research/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isSafeFileSize();
    }

    match /assets/{document=**} {
      allow read: if true;
      allow write: if isAdmin() && isSafeFileSize();
    }

    match /admin_documents/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isSafeFileSize();
    }

    match /payment-proofs/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin() && isSafeFileSize();
    }

    match /resumes/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin() && isSafeFileSize();
    }

    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
