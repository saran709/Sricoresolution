rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Default-Deny Catch-All Safety Net
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Core Authentication, Validation & Document Helpers
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isVerifiedEmail() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-.]+$');
    }

    function isSafeHttpUrl(url) {
      return url is string &&
        url.size() >= 8 &&
        url.size() <= 2048 &&
        url.matches('^https?://.*');
    }

    function hasUserDoc() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verify account is not suspended or deactivated
    function isAccountActive() {
      return isAuthenticated() && (
        !hasUserDoc() || (
          getUserData().get('isActive', true) != false &&
          getUserData().get('status', 'active') != 'suspended'
        )
      );
    }

    // =========================================================================
    // Five-Role RBAC Claim & Profile Validators
    // Permitted Canonical Roles:
    //   1. ADMIN
    //   2. CLIENT
    //   3. EMPLOYEE
    //   4. MENTOR
    //   5. INTERN_STUDENT
    // =========================================================================
    function hasTokenRole(allowedRoles) {
      return isAuthenticated() &&
        ('role' in request.auth.token) &&
        (request.auth.token.role in allowedRoles);
    }

    function hasProfileRole(allowedRoles) {
      return hasUserDoc() && (
        (getUserData().get('role', '') in allowedRoles) ||
        (getUserData().get('canonicalRole', '') in allowedRoles)
      );
    }

    function isVerifiedBootstrapAdmin() {
      return isVerifiedEmail() &&
        request.auth.token.email.lower() == 'saranramesh709@gmail.com';
    }

    // 1. ADMIN Role Validator (requires verified email for bootstrap admin)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        hasTokenRole(['ADMIN', 'ADMINISTRATOR', 'admin', 'administrator']) ||
        isVerifiedBootstrapAdmin() ||
        hasProfileRole(['ADMIN', 'ADMINISTRATOR', 'admin', 'administrator'])
      );
    }

    // 2. CLIENT Role Validator
    function isClient() {
      return isAccountActive() && (
        hasTokenRole(['CLIENT', 'EMPLOYER', 'client']) ||
        hasProfileRole(['CLIENT', 'EMPLOYER', 'client'])
      );
    }

    // 3. EMPLOYEE Role Validator
    function isEmployee() {
      return isAccountActive() && (
        isAdmin() ||
        hasTokenRole(['EMPLOYEE', 'employee']) ||
        hasProfileRole(['EMPLOYEE', 'employee'])
      );
    }

    // 4. MENTOR Role Validator
    function isMentor() {
      return isAccountActive() && (
        isAdmin() ||
        hasTokenRole(['MENTOR', 'mentor']) ||
        hasProfileRole(['MENTOR', 'mentor'])
      );
    }

    // 5. INTERN_STUDENT Role Validator
    function isInternStudent() {
      return isAccountActive() && (
        hasTokenRole([
          'INTERN_STUDENT', 'INTERN', 'STUDENT', 'CANDIDATE',
          'intern_student', 'intern', 'student'
        ]) ||
        hasProfileRole([
          'INTERN_STUDENT', 'INTERN', 'STUDENT', 'CANDIDATE',
          'intern_student', 'intern', 'student'
        ])
      );
    }

    // Verify caller holds one of the 5 defined roles
    function hasValidRole() {
      return isAdmin() || isClient() || isEmployee() || isMentor() || isInternStudent();
    }

    // Relational helpers for Projects & Tasks
    function isAssignedToProject(projectData) {
      return isAuthenticated() && (
        projectData.get('clientId', '') == request.auth.uid ||
        projectData.get('employerId', '') == request.auth.uid ||
        projectData.get('projectManagerId', '') == request.auth.uid ||
        projectData.get('createdBy', '') == request.auth.uid ||
        (projectData.get('teamMemberIds', []) is list &&
          request.auth.uid in projectData.get('teamMemberIds', [])) ||
        (projectData.get('assignedEmployees', []) is list &&
          request.auth.uid in projectData.get('assignedEmployees', [])) ||
        (projectData.get('assignedInterns', []) is list &&
          request.auth.uid in projectData.get('assignedInterns', []))
      );
    }

    function isTaskAssignee(taskData) {
      return isAuthenticated() && (
        taskData.get('assignedTo', '') == request.auth.uid ||
        taskData.get('assigneeId', '') == request.auth.uid ||
        taskData.get('userId', '') == request.auth.uid ||
        (request.auth.token.email != null &&
          taskData.get('assignedTo', '') == request.auth.token.email)
      );
    }

    // =========================================================================
    // 1. Users Collection (`/users/{userId}`)
    // PII Isolation & Anti-Privilege-Escalation Guards
    // =========================================================================
    function isAssignedMentorProfileRead(userId) {
      return hasUserDoc() && (
        getUserData().get('mentorId', '') == userId ||
        getUserData().get('assignedMentorId', '') == userId
      );
    }

    match /users/{userId} {
      // Strictly isolate user PII: owners, ADMIN/EMPLOYEE/MENTOR staff, the intern's
      // assigned mentor doc, or a verified-email pre-provisioned profile matching token email.
      allow read: if isOwner(userId) ||
        isAdmin() ||
        isEmployee() ||
        isMentor() ||
        isAssignedMentorProfileRead(userId) ||
        (isVerifiedEmail() && existing().get('email', '') == request.auth.token.email);

      // Self-registration is strictly limited to non-privileged roles (CLIENT or INTERN_STUDENT)
      // for BOTH `role` and `canonicalRole`, and forbids permission/limit override injection.
      allow create: if isAdmin() || (
        isValidId(userId) &&
        isOwner(userId) &&
        incoming().get('uid', userId) == request.auth.uid &&
        incoming().get('role', 'INTERN_STUDENT') in [
          'CLIENT', 'INTERN_STUDENT', 'INTERN', 'CANDIDATE', 'EMPLOYER'
        ] &&
        incoming().get('canonicalRole', 'INTERN_STUDENT') in [
          'CLIENT', 'INTERN_STUDENT'
        ] &&
        incoming().get('isActive', true) == true &&
        incoming().get('status', 'active') == 'active' &&
        !('permissionOverrides' in incoming()) &&
        !('limitOverrides' in incoming()) &&
        !('accessExpirationDate' in incoming()) &&
        !('mentorId' in incoming()) &&
        !('assignedMentorId' in incoming()) &&
        !('salary' in incoming()) &&
        !('stipend' in incoming())
      );

      // Non-admin users may only edit safe personal profile metadata and login timestamp.
      allow update: if isAdmin() || (
        isValidId(userId) &&
        isOwner(userId) &&
        isAccountActive() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'firstName', 'lastName', 'phone', 'photoUrl',
          'lastLoginAt', 'updatedAt', 'bio', 'skills',
          'githubUrl', 'linkedinUrl', 'portfolioUrl', 'company', 'address'
        ])
      );

      // Only ADMIN can delete user accounts.
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. Projects Collection (`/projects/{projectId}`)
    // =========================================================================
    match /projects/{projectId} {
      // Public portfolio showcase projects (portfolioVisibility == true) are readable on public site;
      // internal & client projects are isolated by role and assignment.
      allow read: if existing().get('portfolioVisibility', false) == true ||
        isAdmin() ||
        isEmployee() ||
        isMentor() ||
        isInternStudent() ||
        (isClient() && isAssignedToProject(existing()));

      // ADMIN and EMPLOYEE can create any project; CLIENT can submit their own non-showcase request.
      allow create: if isValidId(projectId) && (
        isAdmin() ||
        isEmployee() ||
        (
          isClient() &&
          incoming().get('clientId', request.auth.uid) == request.auth.uid &&
          incoming().get('portfolioVisibility', false) == false
        )
      );

      // ADMIN, EMPLOYEE, and MENTOR can manage projects;
      // CLIENT may only update specific feedback/description fields on their own assigned project.
      allow update: if isValidId(projectId) && (
        isAdmin() ||
        isEmployee() ||
        isMentor() ||
        (
          isClient() &&
          isAssignedToProject(existing()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'projectDescription', 'requirements',
            'repositoryUrl', 'updatedAt', 'clientFeedback', 'approvalStatus'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. Tasks Collections (`/tasks/{taskId}` and `/projectTasks/{taskId}`)
    // =========================================================================
    match /tasks/{taskId} {
      allow read: if hasValidRole();

      allow create: if isValidId(taskId) && (isAdmin() || isEmployee() || isMentor());

      // INTERN_STUDENT must BOTH be the assignee AND only touch the allowed submission fields.
      allow update: if isValidId(taskId) && (
        isAdmin() ||
        isEmployee() ||
        isMentor() ||
        (
          isInternStudent() &&
          isTaskAssignee(existing()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'submissionNote', 'submittedAt', 'updatedAt', 'progressPercentage'
          ])
        )
      );

      allow delete: if isAdmin() || isEmployee() || isMentor();
    }

    match /projectTasks/{taskId} {
      allow read: if hasValidRole();

      allow create: if isValidId(taskId) && (isAdmin() || isEmployee() || isMentor());

      // INTERN_STUDENT must BOTH be the assignee AND only touch the allowed submission fields.
      allow update: if isValidId(taskId) && (
        isAdmin() ||
        isEmployee() ||
        isMentor() ||
        (
          isInternStudent() &&
          isTaskAssignee(existing()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'submissionNote', 'submittedAt', 'updatedAt', 'progressPercentage'
          ])
        )
      );

      allow delete: if isAdmin() || isEmployee() || isMentor();
    }

    // =========================================================================
    // 4. Settings & Resource Permissions Collections
    // =========================================================================
    function isValidPermissionId(id) {
      return id is string &&
        id.size() >= 2 &&
        id.size() <= 64 &&
        id.matches('^[a-z0-9_-]+$');
    }

    function isValidRoleCrudAccess(entry) {
      return entry is map &&
        entry.keys().hasAll([
          'create', 'read', 'update', 'delete',
          'upload', 'download', 'approve', 'assign', 'export', 'scope'
        ]) &&
        entry.keys().hasOnly([
          'create', 'read', 'update', 'delete',
          'upload', 'download', 'approve', 'assign', 'export', 'scope'
        ]) &&
        entry.create is bool &&
        entry.read is bool &&
        entry.update is bool &&
        entry.delete is bool &&
        entry.upload is bool &&
        entry.download is bool &&
        entry.approve is bool &&
        entry.assign is bool &&
        entry.export is bool &&
        entry.scope in ['all', 'assigned', 'own', 'none'];
    }

    function isValidPermissionDoc(data, permissionId) {
      return data.keys().hasAll([
          'id', 'resourceKey', 'resourceName', 'category',
          'description', 'roleAccess', 'updatedAt', 'updatedBy'
        ]) &&
        data.keys().hasOnly([
          'id', 'resourceKey', 'resourceName', 'category',
          'description', 'isSystem', 'roleAccess',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ]) &&
        data.id == permissionId &&
        data.resourceKey == permissionId &&
        data.resourceName is string &&
        data.resourceName.size() >= 2 &&
        data.resourceName.size() <= 120 &&
        data.category in [
          'Core Operations', 'Workforce & Mentorship',
          'Finance & Legal', 'System & Security', 'Custom'
        ] &&
        data.description is string &&
        data.description.size() <= 500 &&
        (!('isSystem' in data) || data.isSystem is bool) &&
        data.roleAccess is map &&
        data.roleAccess.keys().hasAll([
          'ADMIN', 'CLIENT', 'EMPLOYEE', 'MENTOR', 'INTERN_STUDENT'
        ]) &&
        data.roleAccess.keys().hasOnly([
          'ADMIN', 'CLIENT', 'EMPLOYEE', 'MENTOR', 'INTERN_STUDENT'
        ]) &&
        isValidRoleCrudAccess(data.roleAccess.ADMIN) &&
        isValidRoleCrudAccess(data.roleAccess.CLIENT) &&
        isValidRoleCrudAccess(data.roleAccess.EMPLOYEE) &&
        isValidRoleCrudAccess(data.roleAccess.MENTOR) &&
        isValidRoleCrudAccess(data.roleAccess.INTERN_STUDENT) &&
        (!(permissionId in ['settings', 'users', 'auditLogs']) || (
          data.roleAccess.ADMIN.read == true &&
          data.roleAccess.ADMIN.create == true &&
          data.roleAccess.ADMIN.update == true &&
          data.roleAccess.ADMIN.scope == 'all'
        )) &&
        data.updatedAt is timestamp &&
        data.updatedBy is string &&
        data.updatedBy == request.auth.uid;
    }

    match /permissions/{permissionId} {
      allow read: if hasValidRole();

      allow create: if isAdmin() &&
        isValidPermissionId(permissionId) &&
        isValidPermissionDoc(incoming(), permissionId) &&
        incoming().get('createdAt', null) is timestamp &&
        incoming().get('createdBy', '') == request.auth.uid;

      allow update: if isAdmin() &&
        isValidPermissionId(permissionId) &&
        isValidPermissionDoc(incoming(), permissionId);

      allow delete: if isAdmin() &&
        isValidPermissionId(permissionId) &&
        !(permissionId in ['settings', 'users', 'auditLogs']);
    }

    match /settings/{docId} {
      allow read: if (docId in ['website_cms', 'website_content']) || hasValidRole();
      allow write: if (
        (docId in ['website_cms', 'website_content']) && isVerifiedBootstrapAdmin()
      ) || (
        !(docId in ['website_cms', 'website_content']) && isVerifiedEmail() && isAdmin()
      );
    }

    // =========================================================================
    // 5. Dynamic Quotas & Resource Consumption (`/quotas/{userId}`)
    // Monotonic Counter Guard Prevents Client-Side Usage Resets via DevTools
    // =========================================================================
    function isValidQuotaPayload(data) {
      return data.keys().hasOnly([
          'projectsCount', 'assignedTasksCount', 'aiRequestsToday',
          'aiRequestsDate', 'storageUsedMB', 'reportsGeneratedCount',
          'assignedMenteesCount', 'activeClientProjectsCount', 'lastUpdated'
        ]) &&
        data.get('projectsCount', 0) is number && data.get('projectsCount', 0) >= 0 &&
        data.get('assignedTasksCount', 0) is number && data.get('assignedTasksCount', 0) >= 0 &&
        data.get('aiRequestsToday', 0) is number && data.get('aiRequestsToday', 0) >= 0 &&
        data.get('storageUsedMB', 0) is number && data.get('storageUsedMB', 0) >= 0 &&
        data.get('reportsGeneratedCount', 0) is number && data.get('reportsGeneratedCount', 0) >= 0 &&
        data.get('assignedMenteesCount', 0) is number && data.get('assignedMenteesCount', 0) >= 0 &&
        data.get('activeClientProjectsCount', 0) is number && data.get('activeClientProjectsCount', 0) >= 0 &&
        (!('aiRequestsDate' in data) || (data.aiRequestsDate is string && data.aiRequestsDate.size() <= 20));
    }

    match /quotas/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isMentor();

      allow create: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && isAccountActive() && isValidQuotaPayload(incoming()))
      );

      allow update: if isValidId(userId) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          isAccountActive() &&
          isValidQuotaPayload(incoming()) &&
          incoming().get('projectsCount', 0) >= existing().get('projectsCount', 0) &&
          incoming().get('assignedTasksCount', 0) >= existing().get('assignedTasksCount', 0) &&
          incoming().get('storageUsedMB', 0) >= existing().get('storageUsedMB', 0) &&
          incoming().get('reportsGeneratedCount', 0) >= existing().get('reportsGeneratedCount', 0) &&
          incoming().get('activeClientProjectsCount', 0) >= existing().get('activeClientProjectsCount', 0) &&
          (
            incoming().get('aiRequestsDate', '') != existing().get('aiRequestsDate', '') ||
            incoming().get('aiRequestsToday', 0) >= existing().get('aiRequestsToday', 0)
          )
        )
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 6. Administrative & Organization Collections
    // =========================================================================
    match /system/{docId} {
      allow read: if isAuthenticated();
      allow create: if isVerifiedBootstrapAdmin() &&
        docId == 'setup' &&
        !exists(/databases/$(database)/documents/system/setup);
      allow update, delete: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if hasValidRole();
      allow write: if isAdmin();
    }

    match /employees/{docId} {
      allow read: if isAdmin() || isEmployee() || isMentor() || isOwner(docId);
      allow update: if isAdmin() || (
        isEmployee() &&
        isOwner(docId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'firstName', 'lastName', 'phone', 'photoUrl', 'skills', 'bio', 'updatedAt'
        ])
      );
      allow create, delete: if isAdmin();
    }

    match /mentors/{docId} {
      allow read: if hasValidRole();
      allow update: if isAdmin() || (
        isMentor() &&
        isOwner(docId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'firstName', 'lastName', 'phone', 'photoUrl', 'bio', 'expertise', 'updatedAt'
        ])
      );
      allow create, delete: if isAdmin();
    }

    match /interns/{docId} {
      allow read: if isAdmin() || isMentor() || isEmployee() || isOwner(docId);
      allow update: if isAdmin() || isMentor() || (
        isInternStudent() &&
        isOwner(docId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'firstName', 'lastName', 'phone', 'photoUrl', 'skills', 'githubUrl', 'linkedinUrl', 'updatedAt'
        ])
      );
      allow create, delete: if isAdmin();
    }

    match /clients/{docId} {
      allow read: if isAdmin() || isEmployee() || isOwner(docId);
      allow update: if isAdmin() || (
        isClient() &&
        isOwner(docId) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'firstName', 'lastName', 'phone', 'photoUrl', 'company', 'website', 'address', 'updatedAt'
        ])
      );
      allow create, delete: if isAdmin();
    }

    match /candidates/{docId} {
      allow read: if isAdmin() || isEmployee() || isMentor() || isOwner(docId);
      allow create: if isValidId(docId) && (
        isAdmin() ||
        (isAuthenticated() && docId == request.auth.uid && incoming().get('uid', request.auth.uid) == request.auth.uid)
      );
      allow update: if isValidId(docId) && (
        isAdmin() ||
        (isOwner(docId) && incoming().diff(existing()).affectedKeys().hasOnly([
          'firstName', 'lastName', 'phone', 'resumeUrl', 'portfolioUrl', 'skills', 'updatedAt'
        ]))
      );
      allow delete: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if isAdmin() || isEmployee();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 7. Audit Logs (`/auditLogs/{logId}`) — Caller-Identity Enforced
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin() ||
        isMentor() ||
        (isAuthenticated() && existing().get('resourceId', '') == request.auth.uid);

      allow create: if isValidId(logId) &&
        hasValidRole() &&
        incoming().keys().hasAll(['action', 'performedBy', 'resourceId', 'resourceType', 'details']) &&
        incoming().keys().hasOnly(['action', 'performedBy', 'resourceId', 'resourceType', 'details', 'timestamp']) &&
        incoming().performedBy == request.auth.uid &&
        incoming().action is string &&
        incoming().action.size() >= 2 &&
        incoming().action.size() <= 100 &&
        incoming().resourceId is string &&
        incoming().resourceId.size() <= 128 &&
        incoming().resourceType is string &&
        incoming().resourceType.size() <= 64 &&
        incoming().details is string &&
        incoming().details.size() <= 2000 &&
        (isAdmin() || !incoming().action.matches('^(RBAC_|ADMIN_|ROLE_|PERMISSION_|SECURITY_).*'));

      allow update, delete: if false;
    }

    // =========================================================================
    // 8. Operations, Documents, Payments & Communications
    // =========================================================================
    match /documents/{docId} {
      allow read: if isAdmin() ||
        isEmployee() ||
        isMentor() ||
        (hasValidRole() && (
          existing().get('ownerId', '') == request.auth.uid ||
          existing().get('accessLevel', '') in ['public', 'all']
        ));

      allow create: if isValidId(docId) && hasValidRole() && (
        isAdmin() ||
        (
          incoming().get('ownerId', '') == request.auth.uid &&
          incoming().get('title', '') is string &&
          incoming().get('title', '').size() >= 1 &&
          incoming().get('title', '').size() <= 200 &&
          isSafeHttpUrl(incoming().get('fileUrl', '')) &&
          incoming().get('accessLevel', 'own') in ['own', 'client', 'private']
        )
      );

      allow update: if isValidId(docId) && (
        isAdmin() ||
        isEmployee() ||
        isMentor() ||
        (
          hasValidRole() &&
          existing().get('ownerId', '') == request.auth.uid &&
          incoming().get('ownerId', '') == request.auth.uid &&
          isSafeHttpUrl(incoming().get('fileUrl', existing().get('fileUrl', '')))
        )
      );

      allow delete: if isAdmin() ||
        (hasValidRole() && existing().get('ownerId', '') == request.auth.uid);
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || isEmployee() ||
        (isAuthenticated() && (
          existing().get('clientId', '') == request.auth.uid ||
          existing().get('userId', '') == request.auth.uid
        ));

      allow create: if isValidId(paymentId) && hasValidRole() && (
        isAdmin() ||
        isEmployee() ||
        (
          (incoming().get('clientId', '') == request.auth.uid ||
            incoming().get('userId', '') == request.auth.uid) &&
          incoming().get('status', '') in ['PENDING', 'pending'] &&
          incoming().get('verificationStatus', 'pending') == 'pending' &&
          incoming().get('amount', 0) is number &&
          incoming().get('amount', 0) > 0 &&
          (!('proofUrl' in incoming()) || isSafeHttpUrl(incoming().proofUrl))
        )
      );

      allow update, delete: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) && (
        isAdmin() ||
        (
          incoming().get('status', 'NEW') == 'NEW' &&
          incoming().get('name', '') is string &&
          incoming().get('name', '').size() <= 200 &&
          incoming().get('email', '') is string &&
          incoming().get('email', '').size() <= 254 &&
          incoming().get('message', '') is string &&
          incoming().get('message', '').size() <= 5000 &&
          (!('clientId' in incoming()) || (isAuthenticated() && incoming().clientId == request.auth.uid))
        )
      );
      allow read: if isAdmin() || isEmployee() ||
        (isClient() && existing().get('clientId', '') == request.auth.uid);
      allow update: if isAdmin() || isEmployee();
      allow delete: if isAdmin();
    }

    match /internship_applications/{applicationId} {
      allow create: if isValidId(applicationId) && (
        isAdmin() ||
        (
          incoming().get('status', 'pending') == 'pending' &&
          (!('candidateId' in incoming()) || (isAuthenticated() && incoming().candidateId == request.auth.uid)) &&
          (!('resumeUrl' in incoming()) || isSafeHttpUrl(incoming().resumeUrl))
        )
      );
      allow read: if isAdmin() || isEmployee() || isMentor() ||
        (isAuthenticated() && existing().get('candidateId', '') == request.auth.uid);
      allow update: if isValidId(applicationId) && (
        isAdmin() ||
        isEmployee() ||
        isMentor() ||
        (
          isAuthenticated() &&
          existing().get('candidateId', '') == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'resumeUrl', 'portfolioUrl', 'coverNote', 'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    match /job_applications/{applicationId} {
      allow create: if isValidId(applicationId) && (
        isAdmin() ||
        (
          incoming().get('status', 'pending') in ['pending', 'NEW', 'SUBMITTED'] &&
          incoming().get('name', '') is string &&
          incoming().get('name', '').size() <= 200 &&
          incoming().get('email', '') is string &&
          incoming().get('email', '').size() <= 254 &&
          (!('resumeUrl' in incoming()) || isSafeHttpUrl(incoming().resumeUrl))
        )
      );
      allow read, update, delete: if isAdmin();
    }

    match /internship_programs/{programId} {
      allow read: if hasValidRole();
      allow write: if isAdmin();
    }

    match /internshipPrograms/{programId} {
      allow read: if hasValidRole();
      allow write: if isAdmin();
    }

    match /attendance/{attId} {
      allow read: if isAdmin() || isEmployee() || isMentor() ||
        (isAuthenticated() && existing().get('userId', '') == request.auth.uid);
      allow create: if isValidId(attId) && (
        isAdmin() ||
        isMentor() ||
        ((isEmployee() || isInternStudent()) && incoming().get('userId', '') == request.auth.uid)
      );
      allow update: if isValidId(attId) && (
        isAdmin() ||
        isMentor() ||
        ((isEmployee() || isInternStudent()) &&
          existing().get('userId', '') == request.auth.uid &&
          incoming().get('userId', '') == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    match /leaveRequests/{leaveId} {
      allow read: if isAdmin() || isEmployee() || isMentor() ||
        (isAuthenticated() && existing().get('userId', '') == request.auth.uid);
      allow create: if isValidId(leaveId) && hasValidRole() && (
        isAdmin() ||
        (
          incoming().get('userId', '') == request.auth.uid &&
          incoming().get('status', 'pending') == 'pending' &&
          incoming().get('reason', '') is string &&
          incoming().get('reason', '').size() <= 1000
        )
      );
      allow update: if isValidId(leaveId) && (
        isAdmin() ||
        isMentor() ||
        (
          isAuthenticated() &&
          existing().get('userId', '') == request.auth.uid &&
          existing().get('status', 'pending') == 'pending' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'reason', 'startDate', 'endDate', 'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    match /announcements/{annId} {
      allow read: if hasValidRole();
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && existing().get('userId', '') == request.auth.uid);
      allow create: if isValidId(notifId) && (
        isAdmin() ||
        isEmployee() ||
        isMentor() ||
        (hasValidRole() && incoming().get('userId', '') == request.auth.uid)
      );
      allow update: if isValidId(notifId) && (
        isAdmin() ||
        (
          isAuthenticated() &&
          existing().get('userId', '') == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() ||
        (isAuthenticated() && existing().get('userId', '') == request.auth.uid);
    }

    match /websiteContent/{docId} {
      allow read: if hasValidRole();
      allow write: if isVerifiedBootstrapAdmin();
    }
  }
}
