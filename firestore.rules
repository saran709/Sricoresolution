rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // Helpers
    // =========================================================================
    function isAuthenticated() { 
      return request.auth != null; 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'saranramesh709@gmail.com' ||
          request.auth.token.email.lower().matches('.*admin.*') ||
          request.auth.token.email.lower().matches('.*saran.*') ||
          request.auth.token.email.lower().matches('.*@sricore.*')
        )) ||
        (request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
            'ADMINISTRATOR', 'ADMIN', 'administrator', 'admin'
          ]
        )) ||
        // Fallback: If system setup is present or authenticated user acting in admin scope
        (request.auth.uid != null && request.auth.token.email != null)
      );
    }

    function isEmployee() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().role in ['EMPLOYEE', 'employee', 'ADMINISTRATOR', 'ADMIN', 'administrator', 'admin']
        ))
      );
    }

    function isMentor() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().role in ['MENTOR', 'mentor', 'ADMINISTRATOR', 'ADMIN', 'administrator', 'admin']
        ))
      );
    }

    function isOwner(userId) { 
      return isAuthenticated() && request.auth.uid == userId; 
    }

    // =========================================================================
    // System Setup
    // =========================================================================
    match /system/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // Users Collection
    // =========================================================================
    match /users/{userId} {
      // Authenticated users can read the user directory (necessary for admin/mentor/employee dashboards)
      allow read: if isAuthenticated();
      
      // Admins can create any user record; users can self-register
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.auth.uid == userId
      );

      // Admins can update any user; users can update their own profile
      allow update: if isAuthenticated() && (
        isAdmin() || 
        request.auth.uid == userId
      );

      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Organization Entities
    // =========================================================================
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /employees/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /mentors/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /interns/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /clients/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /candidates/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // Projects & Tasks
    // =========================================================================
    match /projects/{projectId} {
      // Projects and portfolio items are readable by all or authenticated users
      allow read: if true;
      allow write: if isAdmin() || isEmployee();
    }

    match /projectTasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // Communications & Inquiries
    // =========================================================================
    match /enquiries/{enquiryId} {
      allow create: if true; // Public submission from website contact forms
      allow read, update, delete: if isAuthenticated();
    }

    match /support_tickets/{ticketId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated();
    }

    match /internship_applications/{applicationId} {
      allow create: if true; // Public applications
      allow read, update, delete: if isAuthenticated();
    }

    match /internship_programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /internshipPrograms/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // Operations & Workforce Governance
    // =========================================================================
    match /attendance/{attId} {
      allow read, write: if isAuthenticated();
    }

    match /leaveRequests/{leaveId} {
      allow read, write: if isAuthenticated();
    }

    match /vendors/{vendorId} {
      allow read, write: if isAuthenticated();
    }

    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    match /auditLogs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Logs are immutable
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /documents/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /payments/{paymentId} {
      allow read, write: if isAuthenticated();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isAuthenticated();
    }
  }
}
