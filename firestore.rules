rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasAdminClaim() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function hasAdminProfile() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
          'ADMINISTRATOR', 'ADMIN', 'administrator', 'admin'
        ];
    }

    function isAdmin() {
      // Never grant admin access merely because a user is signed in.
      return hasAdminClaim() || hasAdminProfile();
    }

    function isEmployee() {
      return isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
            'EMPLOYEE', 'employee'
          ]
        )
      );
    }

    function isMentor() {
      return isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
            'MENTOR', 'mentor'
          ]
        )
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /system/{docId} {
      allow read: if true;
      // Initial setup may write only while the system setup document is absent.
      allow create: if isAuthenticated() && docId == 'setup'
        && !exists(/databases/$(database)/documents/system/setup);
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['CANDIDATE', 'CLIENT'];
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
      );
      allow delete: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee());
      allow write: if isAdmin();
    }
    match /employees/{docId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee());
      allow write: if isAdmin();
    }
    match /mentors/{docId} {
      allow read: if isAuthenticated() && (isAdmin() || isMentor());
      allow write: if isAdmin();
    }
    match /interns/{docId} {
      allow read: if isAuthenticated() && (isAdmin() || isMentor());
      allow write: if isAdmin();
    }
    match /clients/{docId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee());
      allow write: if isAdmin() || isEmployee();
    }
    match /candidates/{docId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee() || isMentor());
      allow write: if isAdmin() || isEmployee() || isMentor();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin() || isEmployee();
    }
    match /projectTasks/{taskId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isAdmin() || isEmployee() || resource.data.assigneeId == request.auth.uid
        || resource.data.createdBy == request.auth.uid
      );
    }
    match /tasks/{taskId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isAdmin() || isEmployee() || resource.data.assigneeId == request.auth.uid
        || resource.data.assignedTo == request.auth.uid || resource.data.createdBy == request.auth.uid
      );
    }

    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated() && (isAdmin() || isEmployee());
    }
    match /support_tickets/{ticketId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid || resource.data.createdBy == request.auth.uid
      );
    }
    match /internship_applications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated() && (isAdmin() || isEmployee() || isMentor());
    }
    match /internship_programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /internshipPrograms/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /attendance/{attId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isEmployee() || resource.data.userId == request.auth.uid
        || resource.data.employeeId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() || request.resource.data.userId == request.auth.uid
        || request.resource.data.employeeId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid || resource.data.employeeId == request.auth.uid
        )
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.employeeId == resource.data.employeeId
      );
      allow delete: if isAdmin();
    }
    match /leaveRequests/{leaveId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isEmployee() || resource.data.userId == request.auth.uid
        || resource.data.employeeId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() || request.resource.data.userId == request.auth.uid
        || request.resource.data.employeeId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid || resource.data.employeeId == request.auth.uid
        )
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.employeeId == resource.data.employeeId
      );
      allow delete: if isAdmin();
    }
    match /vendors/{vendorId} {
      allow read, create, update: if isAuthenticated() && (isAdmin() || isEmployee());
      allow delete: if isAdmin();
    }
    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAdmin() || isEmployee();
    }
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
        || resource.data.uid == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() || request.resource.data.userId == request.auth.uid
        || request.resource.data.uid == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
        || resource.data.uid == request.auth.uid
      );
    }
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /documents/{docId} {
      allow read, create: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
        || request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
    }
    match /payments/{paymentId} {
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
      allow read: if isAuthenticated() && (
        isAdmin() || isEmployee() || resource.data.clientId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.clientId == request.auth.uid
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.status == resource.data.status
        && request.resource.data.verificationStatus == resource.data.verificationStatus
      );
      allow delete: if isAdmin();
    }
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isEmployee() || resource.data.clientId == request.auth.uid
      );
      allow create, update: if isAuthenticated() && (isAdmin() || isEmployee());
      allow delete: if isAdmin();
    }
  }
}
