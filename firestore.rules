rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // Core Helper Functions
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMINISTRATOR';
    }

    function isEmployee() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'EMPLOYEE';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidId(id) {
      return id != null && id != '';
    }

    // =========================================================================
    // Admin Initialization
    // =========================================================================
    match /system/setup {
      allow read: if true;
      allow create: if isAuthenticated() 
                    && !exists(/databases/$(database)/documents/system/setup)
                    && incoming().keys().hasAll(['isInitialized'])
                    && incoming().isInitialized == true;
      allow update, delete: if false;
    }

    // =========================================================================
    // Users Collection
    // =========================================================================
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
          && data.email is string && data.email.size() <= 150
          && data.role is string
          && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if isValidId(userId) && (isAdmin() || isOwner(userId) || isEmployee());
      
      allow create: if isValidId(userId) && isAuthenticated() && request.auth.uid == userId && (
        (isValidUser(incoming()))
        ||
        (incoming().role == 'ADMINISTRATOR'
          && isValidUser(incoming()) 
          && !exists(/databases/$(database)/documents/system/setup)
          && existsAfter(/databases/$(database)/documents/system/setup)
        )
        ||
        (isAdmin() && isValidUser(incoming()))
      );
      
      allow update: if isValidId(userId) && isAuthenticated() && (
        (isAdmin())
        ||
        (isOwner(userId) && incoming().role == existing().role && incoming().createdAt == existing().createdAt)
      );
      
      allow delete: if isValidId(userId) && isAdmin();
    }

    // =========================================================================
    // Core Workflow Collections
    // =========================================================================
    match /project_requests/{requestId} {
      allow create: if true;
      allow read, update: if isValidId(requestId) && (isAdmin() || isEmployee() || (isAuthenticated() && resource.data.clientId == request.auth.uid));
      allow delete: if isValidId(requestId) && isAdmin();
    }

    match /internship_applications/{applicationId} {
      allow create: if true;
      allow read, update: if isValidId(applicationId) && (isAdmin() || isEmployee() || (isAuthenticated() && resource.data.candidateId == request.auth.uid));
      allow delete: if isValidId(applicationId) && isAdmin();
    }
  }
}
