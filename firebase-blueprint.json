{
  "entities": {
    "User": {
      "title": "User",
      "description": "Core user profile and Five-Role RBAC record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "role": {
          "type": "string",
          "enum": ["ADMIN", "CLIENT", "EMPLOYEE", "MENTOR", "INTERN_STUDENT"],
          "description": "Assigned canonical role in the 5-role RBAC system"
        },
        "canonicalRole": {
          "type": "string",
          "enum": ["ADMIN", "CLIENT", "EMPLOYEE", "MENTOR", "INTERN_STUDENT"]
        },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "isActive": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "suspended", "inactive"] }
      },
      "required": ["email", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "Commercial, R&D, or student engineering project",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "projectType": { "type": "string" },
        "status": { "type": "string" },
        "clientId": { "type": "string" },
        "projectManagerId": { "type": "string" },
        "portfolioVisibility": { "type": "boolean" }
      },
      "required": ["name", "status"]
    },
    "Task": {
      "title": "Task",
      "description": "Project or learning task assigned to an employee or intern/student",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedTo": { "type": "string" },
        "assigneeId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["TODO", "IN_PROGRESS", "BLOCKED", "REVIEW", "COMPLETED"]
        }
      },
      "required": ["title", "status"]
    },
    "Setting": {
      "title": "Setting",
      "description": "System and RBAC configuration document managed by ADMIN",
      "type": "object",
      "properties": {
        "updatedBy": { "type": "string" }
      }
    },
    "Quota": {
      "title": "Quota",
      "description": "Atomic per-user dynamic limit and resource consumption counters",
      "type": "object",
      "properties": {
        "projectsCount": { "type": "number" },
        "assignedTasksCount": { "type": "number" },
        "aiRequestsToday": { "type": "number" },
        "storageUsedMB": { "type": "number" },
        "reportsGeneratedCount": { "type": "number" },
        "assignedMenteesCount": { "type": "number" },
        "activeClientProjectsCount": { "type": "number" }
      }
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative and security audit trail",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "performedBy": { "type": "string" },
        "resourceId": { "type": "string" },
        "resourceType": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["action", "performedBy"]
    },
    "Permission": {
      "title": "Permission",
      "description": "Resource-level CRUD access control policy across the five canonical RBAC roles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "resourceKey": { "type": "string" },
        "resourceName": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["Core Operations", "Workforce & Mentorship", "Finance & Legal", "System & Security", "Custom"]
        },
        "description": { "type": "string" },
        "isSystem": { "type": "boolean" },
        "roleAccess": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "resourceKey", "resourceName", "category", "roleAccess", "updatedAt", "updatedBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Registered users governed by the 5-role RBAC system"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Projects restricted by role claims and assignment"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Engineering and mentorship tasks"
    },
    "/projectTasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Project-linked tasks and intern deliverables"
    },
    "/settings/{docId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "Administrative and RBAC configuration documents"
    },
    "/quotas/{userId}": {
      "schema": { "$ref": "#/entities/Quota" },
      "description": "Per-user dynamic resource consumption tracking"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable security and operational audit logs"
    },
    "/permissions/{permissionId}": {
      "schema": { "$ref": "#/entities/Permission" },
      "description": "Normalized resource-level CRUD permissions governed atomically by PermissionService"
    }
  }
}
