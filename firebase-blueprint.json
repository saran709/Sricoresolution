{
  "projectInfo": {
    "name": "Sricore Solutions"
  },
  "roles": [
    "ADMINISTRATOR",
    "EMPLOYEE",
    "MENTOR",
    "INTERN",
    "CLIENT",
    "CANDIDATE"
  ],
  "collections": [
    {
      "name": "users",
      "description": "Core user records containing role and authentication data",
      "schema": {
        "email": "string",
        "role": "string",
        "createdAt": "timestamp"
      },
      "permissions": {
        "read": "request.auth.uid == documentId || request.auth.token.role == 'ADMINISTRATOR'",
        "create": "request.auth.token.role == 'ADMINISTRATOR'",
        "update": "request.auth.uid == documentId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || request.auth.token.role == 'ADMINISTRATOR'",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "employees",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.uid == documentId || request.auth.token.role == 'EMPLOYEE'",
        "create": "request.auth.token.role == 'ADMINISTRATOR'",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.uid == documentId",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "departments",
      "permissions": {
        "read": "request.auth != null",
        "create": "request.auth.token.role == 'ADMINISTRATOR'",
        "update": "request.auth.token.role == 'ADMINISTRATOR'",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "mentors",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'MENTOR' || request.auth.token.role == 'EMPLOYEE'",
        "create": "request.auth.token.role == 'ADMINISTRATOR'",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.uid == documentId",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "interns",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.uid == documentId || request.auth.token.role == 'MENTOR' || request.auth.token.role == 'EMPLOYEE'",
        "create": "request.auth.token.role == 'ADMINISTRATOR'",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.uid == documentId || request.auth.token.role == 'MENTOR'",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "clients",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE' || request.auth.uid == documentId",
        "create": "request.auth.token.role == 'ADMINISTRATOR'",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.uid == documentId",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "candidates",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.uid == documentId || request.auth.token.role == 'EMPLOYEE'",
        "create": "true",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.uid == documentId",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "projects",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE' || (request.auth.token.role == 'CLIENT' && resource.data.clientId == request.auth.uid) || (request.auth.token.role == 'INTERN' && resource.data.assignedInterns.hasAny([request.auth.uid]))",
        "create": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "projectTasks",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE' || (request.auth.token.role == 'INTERN' && resource.data.assigneeId == request.auth.uid) || (request.auth.token.role == 'MENTOR')",
        "create": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE' || request.auth.token.role == 'MENTOR'",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE' || request.auth.token.role == 'MENTOR' || request.auth.uid == resource.data.assigneeId",
        "delete": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'"
      }
    },
    {
      "name": "internshipPrograms",
      "permissions": {
        "read": "true",
        "create": "request.auth.token.role == 'ADMINISTRATOR'",
        "update": "request.auth.token.role == 'ADMINISTRATOR'",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "internshipApplications",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE' || request.auth.uid == resource.data.candidateId",
        "create": "request.auth != null",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE' || request.auth.uid == resource.data.candidateId",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "enquiries",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE' || request.auth.uid == resource.data.clientId",
        "create": "true",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "payments",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.uid == resource.data.userId",
        "create": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.uid == resource.data.userId",
        "update": "request.auth.token.role == 'ADMINISTRATOR'",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "invoices",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE' || request.auth.uid == resource.data.clientId",
        "create": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "documents",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE' || request.auth.uid == resource.data.ownerId",
        "create": "request.auth != null",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.uid == resource.data.ownerId",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "notifications",
      "permissions": {
        "read": "request.auth.uid == resource.data.userId",
        "create": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'",
        "update": "request.auth.uid == resource.data.userId",
        "delete": "request.auth.uid == resource.data.userId"
      }
    },
    {
      "name": "attendance",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE' || request.auth.uid == resource.data.userId",
        "create": "request.auth.uid == resource.data.userId || request.auth.token.role == 'ADMINISTRATOR'",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.uid == resource.data.userId",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "leaveRequests",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE' || request.auth.uid == resource.data.userId",
        "create": "request.auth.uid == resource.data.userId",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "announcements",
      "permissions": {
        "read": "request.auth != null",
        "create": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "vendors",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'",
        "create": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'",
        "update": "request.auth.token.role == 'ADMINISTRATOR' || request.auth.token.role == 'EMPLOYEE'",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    },
    {
      "name": "auditLogs",
      "permissions": {
        "read": "request.auth.token.role == 'ADMINISTRATOR'",
        "create": "request.auth != null",
        "update": "false",
        "delete": "false"
      }
    },
    {
      "name": "websiteContent",
      "permissions": {
        "read": "true",
        "create": "request.auth.token.role == 'ADMINISTRATOR'",
        "update": "request.auth.token.role == 'ADMINISTRATOR'",
        "delete": "request.auth.token.role == 'ADMINISTRATOR'"
      }
    }
  ]
}
